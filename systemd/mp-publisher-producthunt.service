[Unit]
Description=QJAI Product Hunt WeChat draft publisher (rolling READY recovery)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-publisher
UMask=0077
StateDirectory=mp-publisher
StateDirectoryMode=0700
# Use a writable Docker CLI config directory inside the service sandbox.
RuntimeDirectory=mp-publisher-producthunt-docker
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/mp-publisher-producthunt-docker
ExecStart=/usr/bin/flock --nonblock /run/lock/mp-publisher-producthunt.lock /usr/bin/docker compose -f /opt/mp-publisher/compose.yaml run --rm --no-deps --pull never mp-publisher run --profile producthunt --auto
TimeoutStartSec=900
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mp-publisher /run/lock /run/mp-publisher-producthunt-docker
