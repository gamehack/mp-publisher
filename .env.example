# Copy to .env, chmod 0600, and provide secrets locally. Never commit .env.
NOTION_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Existing permanent WeChat cover media IDs, one per editorial profile.
WECHAT_THUMB_MEDIA_ID_X=
WECHAT_THUMB_MEDIA_ID_PRODUCTHUNT=
WECHAT_THUMB_MEDIA_ID_TRUSTMRR=
WECHAT_THUMB_MEDIA_ID_OVERSEAS=

QJAI_PUBLISHER_STATE=/var/lib/mp-publisher/state.sqlite

# Master WeChat switch. Production starts fail-closed.
WECHAT_ENABLE_DRAFTS=false

# Profile switches. A draft requires both its channel master and profile switch.
PUBLISH_X_ENABLED=false
PUBLISH_PRODUCTHUNT_ENABLED=false
PUBLISH_TRUSTMRR_ENABLED=false
PUBLISH_OVERSEAS_ENABLED=false
WECHAT_X_ENABLED=false
WECHAT_PRODUCTHUNT_ENABLED=false
WECHAT_TRUSTMRR_ENABLED=false
WECHAT_OVERSEAS_ENABLED=false
